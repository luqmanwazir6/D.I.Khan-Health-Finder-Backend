# Application Environment
NODE_ENV=development
PORT=5000

# Database Configuration (supports local mongodb or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/dikhan-health-finder

# JWT Authentication
# Generate a secure 32+ character key using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=super_secret_jwt_signing_key_dikhan_health_platform_2025_32chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated list for Vite frontend, production domains, etc.)
CLIENT_URL=http://localhost:5173,http://localhost:3000

# Security & Hashing
BCRYPT_SALT_ROUNDS=12

# Global & Auth Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Initial Admin Seeding Configuration
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@dikhanhealth.pk
SEED_ADMIN_PASSWORD=AdminPass123!
